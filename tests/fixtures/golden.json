{
  "winget": [
    {
      "name": "parses rows with an Available column",
      "input": "Name                    Id                  Version   Available Source\n----------------------------------------------------------------------------------------\nMozilla Firefox         Mozilla.Firefox      128.0     129.0      winget\nObsidian                Obsidian.Obsidian    1.8.0                winget\n",
      "sourceScope": "winget",
      "expected": [
        {
          "name": "Mozilla Firefox",
          "id": "Mozilla.Firefox",
          "version": "128.0",
          "source": "winget"
        },
        {
          "name": "Obsidian",
          "id": "Obsidian.Obsidian",
          "version": "1.8.0",
          "source": "winget"
        }
      ]
    },
    {
      "name": "parses rows without an Available column",
      "input": "Name                    Id                  Version   Source\n----------------------------------------------------------------------------------------\nSteam                   Valve.Steam          2.10      winget\n",
      "sourceScope": null,
      "expected": [
        {
          "name": "Steam",
          "id": "Valve.Steam",
          "version": "2.10",
          "source": "winget"
        }
      ]
    },
    {
      "name": "rejects truncated, foreign-source, and malformed rows",
      "input": "Name                    Id                  Version   Available Source\n----------------------------------------------------------------------------------------\nVery Long Applicatio…   Mozilla.Firefox      128.0     129.0      winget\nStore App               Microsoft.Store      1.0                  msstore\nNo Dot Id               Firefox              128.0                winget\n",
      "sourceScope": "winget",
      "expected": []
    },
    {
      "name": "strips ANSI colour codes before parsing",
      "input": "\u001b[0mName                    Id                  Version   Source\n----------------------------------------------------------------------------------------\n\u001b[32mSteam\u001b[0m                   Valve.Steam          2.10      winget\n",
      "sourceScope": null,
      "expected": [
        {
          "name": "Steam",
          "id": "Valve.Steam",
          "version": "2.10",
          "source": "winget"
        }
      ]
    },
    {
      "name": "returns nothing without a separator line",
      "input": "Name Id Version Source\nSteam Valve.Steam 2.10 winget\n",
      "sourceScope": "winget",
      "expected": []
    }
  ],
  "wingetIds": [
    {
      "input": "Mozilla.Firefox",
      "expected": true
    },
    {
      "input": "Valve.Steam",
      "expected": true
    },
    {
      "input": "Obsidian.Obsidian",
      "expected": true
    },
    {
      "input": "Firefox",
      "expected": false
    },
    {
