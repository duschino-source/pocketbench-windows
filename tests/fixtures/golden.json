  "gates": [
    {
      "name": "official source satisfies the gate",
      "operation": "windows.clearUserProxy",
      "sources": [
        {
          "url": "https://support.microsoft.com/fix",
          "supports": "windows.clearUserProxy",
          "corroboratedBy": []
        }
      ],
      "expectedBlocked": false
    },
    {
      "name": "two posts from one publisher do not corroborate",
      "operation": "windows.clearUserProxy",
      "sources": [
        {
          "url": "https://reddit.com/r/windows/a",
          "supports": "windows.clearUserProxy",
          "corroboratedBy": [
            "https://old.reddit.com/r/windows/b"
          ]
        },
        {
          "url": "https://old.reddit.com/r/windows/b",
          "supports": "windows.clearUserProxy",
          "corroboratedBy": [
            "https://reddit.com/r/windows/a"
          ]
        }
      ],
      "expectedBlocked": true
    },
    {
      "name": "two independent publishers corroborate",
      "operation": "windows.clearUserProxy",
      "sources": [
        {
          "url": "https://reddit.com/r/windows/a",
          "supports": "windows.clearUserProxy",
          "corroboratedBy": [
            "https://vendor-forum.example/fix"
          ]
        },
        {
          "url": "https://vendor-forum.example/fix",
          "supports": "windows.clearUserProxy",
          "corroboratedBy": [
            "https://reddit.com/r/windows/a"
          ]
        }
      ],
      "expectedBlocked": false
    },
    {
      "name": "source for a different operation does not satisfy the gate",
      "operation": "windows.clearUserProxy",
      "sources": [
        {
          "url": "https://support.microsoft.com/fix",
          "supports": "app.repairPackage",
          "corroboratedBy": []
        }
      ],
      "expectedBlocked": true
    }
  ],
