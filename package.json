{
  "name": "pocketbench",
  "version": "0.2.0",
  "description": "Windows and application repair powered by Meta Muse Spark",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "author": "PocketBench contributors",
  "engines": { "node": ">=24" },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:native": "vitest run tests/windows-native.test.ts",
    "gateway": "node tools/budget-gateway.mjs",
    "dist": "npm run typecheck && npm run build && electron-builder --win nsis portable --publish never",
    "clean": "node -e \"for (const p of ['out','release']) require('node:fs').rmSync(p, {recursive: true, force: true})\"",
    "audit": "npm audit --audit-level=moderate",
    "sbom": "npm sbom --package-lock-only --sbom-format=cyclonedx --omit=dev",
    "hashes": "node tools/hashes.mjs",
    "size": "node tools/size.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.0.0",
    "@fluentui/react-icons": "^2.0.0",
    "electron-updater": "^6.8.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "dev.pocketbench.desktop",
    "productName": "PocketBench",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "compression": "maximum",
    "removePackageScripts": true,
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "resources/**/*"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "packElevateHelper": false,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "duschino-source",
        "repo": "pocketbench-windows",
        "releaseType": "draft"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/duschino-source/pocketbench-windows.git"
  }
}
