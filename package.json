{
  "name": "pocketbench",
  "version": "0.1.0",
  "description": "Windows and application repair powered by Meta Muse Spark",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "author": "PocketBench contributors",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:native": "vitest run tests/windows-native.test.ts",
    "gateway": "node tools/budget-gateway.mjs",
    "dist": "npm run typecheck && npm run build && electron-builder --win nsis portable",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.0.0",
    "@fluentui/react-icons": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "dev.pocketbench.desktop",
    "productName": "PocketBench",
    "directories": { "output": "release" },
    "files": ["out/**/*", "resources/**/*", "package.json"],
    "asarUnpack": ["resources/**/*"],
    "win": { "icon": "resources/icon.ico", "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false, "createDesktopShortcut": true }
  }
}
